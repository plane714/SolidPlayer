<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        媒体库自动发现需要读全机视频。

        分两套权限，因为「所有文件访问」是 Android 11（API 30）才有的：
        - API 30+：MANAGE_EXTERNAL_STORAGE。targetSdk 已远高于 30，分区存储强制生效，
          只给 READ_EXTERNAL_STORAGE 的话连 java.io.File 都读不到共享目录，
          遍历不出「哪些文件夹里有视频」。
        - API ≤ 29：READ_EXTERNAL_STORAGE（运行时申请）。
          注意 **Android 10（API 29）两边都不成立** —— 没有 MANAGE_EXTERNAL_STORAGE，
          又已经强制分区存储；那一个版本会自动退化成「只读系统媒体库索引」。

        MANAGE_EXTERNAL_STORAGE 需要用户在系统设置里手动开启，应用内只能引导，无法直接弹窗申请。
        上架 Google Play 时该权限需单独申请豁免（本地视频播放器属于可申报名目）。
    -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />

    <!--
        关闭「预测性返回」的系统预览动画。
        对 Android 13~15 有效；Android 16（API 36）起系统对 targetSdk >= 36 的应用
        默认开启该行为、此属性可能被忽略 —— 所以真正的兜底是 SolidPlayerNavHost 里
        把 pop 过渡设为 None（那边不依赖系统开关，任何版本都生效）。
    -->

    <application
        android:name=".SolidPlayerApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="false"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SolidPlayer"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.SolidPlayer">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
